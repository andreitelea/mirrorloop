# Normalizza i fine riga: nel repository sempre LF, così i file restano
# identici tra il PC Windows e le macchine macOS di GitHub Actions.
* text=auto

# Questi file Windows vogliono CRLF anche dopo il checkout.
*.sln     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf
