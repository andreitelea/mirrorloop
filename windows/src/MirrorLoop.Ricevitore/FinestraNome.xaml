<Window x:Class="MirrorLoop.Ricevitore.FinestraNome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Fondo}"
        FocusManager.FocusedElement="{Binding ElementName=CampoNome}">
    <!-- I colori seguono la modalità chiara o scura di Windows (Tema.Applica nel costruttore). -->
    <StackPanel Margin="24,20" MinWidth="400">
        <TextBlock x:Name="TestoNomeSpiegazione" FontSize="14" Foreground="{DynamicResource Testo}" />
        <TextBox x:Name="CampoNome" Margin="0,12,0,0" />
        <TextBlock x:Name="TestoPredefinito" Foreground="{DynamicResource TestoTenue}" FontSize="12" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="PulsantePredefinito" Click="SuPredefinito" MinWidth="100" Margin="0,0,24,0" />
            <Button x:Name="PulsanteSalva" Click="SuSalva" IsDefault="True" MinWidth="90" Margin="0,0,8,0"
                    Style="{StaticResource PulsantePrincipale}" />
            <Button x:Name="PulsanteAnnulla" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
