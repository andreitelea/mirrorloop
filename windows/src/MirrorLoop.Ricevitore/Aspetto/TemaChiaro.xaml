<!-- Colori del tema chiaro: le finestrelle quando Windows è in modalità chiara. Stesse chiavi di
     TemaScuro.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Fondo" Color="#F9F9F9" />
    <SolidColorBrush x:Key="Testo" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TestoTenue" Color="#616161" />
    <SolidColorBrush x:Key="Pulsante" Color="#FDFDFD" />
    <SolidColorBrush x:Key="PulsanteSopra" Color="#F3F3F3" />
    <SolidColorBrush x:Key="PulsantePremuto" Color="#EBEBEB" />
    <SolidColorBrush x:Key="BordoPulsante" Color="#D1D1D1" />
    <SolidColorBrush x:Key="Campo" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BordoCampo" Color="#D1D1D1" />
    <SolidColorBrush x:Key="Accento" Color="#5B35D5" />
    <SolidColorBrush x:Key="AccentoSopra" Color="#6A47DD" />
    <SolidColorBrush x:Key="AccentoPremuto" Color="#4F2DBF" />
    <SolidColorBrush x:Key="TestoSuAccento" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Selezione" Color="#B9A6F5" />
    <SolidColorBrush x:Key="Riquadro" Color="#F8FFFFFF" />
    <SolidColorBrush x:Key="BordoRiquadro" Color="#D1D1D1" />
</ResourceDictionary>
