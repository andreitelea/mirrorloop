<Window x:Class="MirrorLoop.Ricevitore.FinestraPrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MirrorLoop"
        Icon="MirrorLoop.ico"
        Width="1280" Height="760"
        Background="Black"
        KeyDown="SuTastoPremuto">
    <Grid>
        <!-- Il video: riempie la finestra mantenendo le proporzioni (bande nere se servono). -->
        <Image x:Name="Video" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />

        <!-- Senza video: lo stato e il nome da scegliere sull'iPhone. -->
        <StackPanel x:Name="PannelloAttesa" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TestoStato"
                       HorizontalAlignment="Center"
                       Foreground="#B0B0B0" FontSize="22" TextAlignment="Center"
                       />
            <TextBlock x:Name="TestoNomePC"
                       HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="#808080" FontSize="16" TextAlignment="Center" />
            <!-- L'ultimo iPhone rifiutato e perché: sparisce quando un iPhone si collega. -->
            <TextBlock x:Name="TestoRifiuto" Visibility="Collapsed"
                       HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="#D09A5A" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900" />
        </StackPanel>

        <!-- Riquadro delle statistiche: il tasto S lo mostra e lo nasconde,
             così non finisce in diretta quando OBS riprende la finestra. -->
        <Border x:Name="RiquadroStatistiche" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Padding="10,8" CornerRadius="4" Background="#B0000000">
            <TextBlock x:Name="TestoStatistiche"
                       Foreground="White" FontFamily="Consolas" FontSize="14"
                       Text="—" />
        </Border>

        <!-- Avviso se la rete di casa è impostata come Pubblica (il firewall lascia passare l'iPhone
             solo sulle reti private). -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,16">
            <Border x:Name="RiquadroAvvisoRete" Visibility="Collapsed" Margin="0,0,0,8"
                    Padding="16,10" CornerRadius="6" Background="#E0402A00" BorderBrush="#FFB000" BorderThickness="1">
                <TextBlock x:Name="TestoAvvisoRete" Foreground="#FFD27F" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
            <!-- I tasti principali, solo finché non c'è video (sparisce con la schermata di attesa). -->
            <TextBlock x:Name="TestoTastiInBasso" Visibility="{Binding Visibility, ElementName=PannelloAttesa}"
                       HorizontalAlignment="Center" Foreground="#707070" FontSize="14"
                       />
        </StackPanel>

        <!-- Aiuto (F1): tutti i tasti, anche durante la trasmissione. -->
        <Border x:Name="RiquadroAiuto" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="32,24" CornerRadius="8" Background="#F0202020"
                BorderBrush="#606060" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="TestoAiutoTitolo" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid TextElement.FontSize="16">
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#D0D0D0" />
                            <Setter Property="Margin" Value="0,3" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="F1" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TestoAiutoF1" Grid.Row="0" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="S" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TestoAiutoS" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="O" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TestoAiutoO" Grid.Row="2" Grid.Column="1" />
                    <TextBlock Grid.Row="3" Text="A" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TestoAiutoA" Grid.Row="3" Grid.Column="1" />
                    <TextBlock Grid.Row="4" Text="N" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TestoAiutoN" Grid.Row="4" Grid.Column="1" />
                    <TextBlock Grid.Row="5" Text="D" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TestoAiutoD" Grid.Row="5" Grid.Column="1" />
                    <TextBlock Grid.Row="6" Text="Esc" Foreground="White" FontFamily="Consolas" />
                    <TextBlock x:Name="TestoAiutoEsc" Grid.Row="6" Grid.Column="1" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Richiesta di abbinamento di un iPhone nuovo: compare solo quando serve. Consenti si
             preme solo con il mouse (un tasto per sbaglio non deve abbinare nessuno); Esc rifiuta. -->
        <Border x:Name="RiquadroAbbinamento" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="32,24" CornerRadius="8" Background="#F0202020"
                BorderBrush="#606060" BorderThickness="1">
            <StackPanel MinWidth="380">
                <TextBlock x:Name="TestoAbbinamentoTitolo" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="NomeAbbinamento" Foreground="#B0B0B0" FontSize="16" Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CodiceAbbinamento" Foreground="White" FontFamily="Consolas" FontSize="56"
                           Margin="0,16,0,8" HorizontalAlignment="Center" />
                <TextBlock x:Name="TestoAbbinamentoIstruzioni" Foreground="#D0D0D0" FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ScadenzaAbbinamento" Foreground="#909090" FontSize="14" Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="PulsanteConsenti" Click="SuConsenti" Focusable="False"
                            MinWidth="120" Padding="12,6" Margin="0,0,12,0" FontSize="16" />
                    <Button x:Name="PulsanteRifiuta" Click="SuRifiuta" Focusable="False"
                            MinWidth="120" Padding="12,6" FontSize="16" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
