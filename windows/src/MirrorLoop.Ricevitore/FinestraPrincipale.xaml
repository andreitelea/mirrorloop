<Window x:Class="MirrorLoop.Ricevitore.FinestraPrincipale"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MirrorLoop"
        Width="1280" Height="760"
        Background="Black"
        KeyDown="SuTastoPremuto">
    <Grid>
        <!-- Il video: riempie la finestra mantenendo le proporzioni (bande nere se servono). -->
        <Image x:Name="Video" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" />

        <TextBlock x:Name="TestoStato"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#B0B0B0" FontSize="22" TextAlignment="Center"
                   Text="Avvio..." />

        <!-- Riquadro delle statistiche: il tasto S lo mostra e lo nasconde,
             così non finisce in diretta quando OBS riprende la finestra. -->
        <Border x:Name="RiquadroStatistiche"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Padding="10,8" CornerRadius="4" Background="#B0000000">
            <TextBlock x:Name="TestoStatistiche"
                       Foreground="White" FontFamily="Consolas" FontSize="14"
                       Text="—" />
        </Border>

        <!-- Avviso se la rete di casa è impostata come Pubblica (il firewall lascia passare l'iPhone
             solo sulle reti private). -->
        <Border x:Name="RiquadroAvvisoRete" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,24"
                Padding="16,10" CornerRadius="6" Background="#E0402A00" BorderBrush="#FFB000" BorderThickness="1">
            <TextBlock x:Name="TestoAvvisoRete" Foreground="#FFD27F" FontSize="16" TextAlignment="Center" TextWrapping="Wrap" />
        </Border>

        <!-- Richiesta di abbinamento di un iPhone nuovo: compare solo quando serve. Consenti si
             preme solo con il mouse (un tasto per sbaglio non deve abbinare nessuno); Esc rifiuta. -->
        <Border x:Name="RiquadroAbbinamento" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="32,24" CornerRadius="8" Background="#F0202020"
                BorderBrush="#606060" BorderThickness="1">
            <StackPanel MinWidth="380">
                <TextBlock Text="Un iPhone vuole collegarsi" Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="NomeAbbinamento" Foreground="#B0B0B0" FontSize="16" Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="CodiceAbbinamento" Foreground="White" FontFamily="Consolas" FontSize="56"
                           Margin="0,16,0,8" HorizontalAlignment="Center" />
                <TextBlock Text="Consenti solo se sull'iPhone compare lo stesso codice." Foreground="#D0D0D0" FontSize="16"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ScadenzaAbbinamento" Foreground="#909090" FontSize="14" Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="PulsanteConsenti" Content="Consenti" Click="SuConsenti" Focusable="False"
                            MinWidth="120" Padding="12,6" Margin="0,0,12,0" FontSize="16" />
                    <Button x:Name="PulsanteRifiuta" Content="Rifiuta" Click="SuRifiuta" Focusable="False"
                            MinWidth="120" Padding="12,6" FontSize="16" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
