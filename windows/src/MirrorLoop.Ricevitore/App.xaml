<Application x:Class="MirrorLoop.Ricevitore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="FinestraPrincipale.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Scuro come base: ogni finestra aggiunge il suo tema (Tema.Applica). -->
                <ResourceDictionary Source="Aspetto/TemaScuro.xaml" />
                <ResourceDictionary Source="Aspetto/Stili.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
