<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Serve per copiare i frame da e verso la memoria di Media Foundation. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MirrorLoop.Protocollo\MirrorLoop.Protocollo.csproj" />
    <ProjectReference Include="..\..\src\MirrorLoop.MediaFoundation\MirrorLoop.MediaFoundation.csproj" />
  </ItemGroup>

</Project>
